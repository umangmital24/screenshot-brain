VITE_API_BASE=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxx-or-legacy-anon-key
# Optional. Leave empty until the official Android APK has been uploaded.
# Use an HTTPS download URL or /downloads/samhaal.apk (a public site asset).
VITE_ANDROID_APK_URL=
# Public Google OAuth Web Client ID, same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID on Android.
# Optional: web login falls back to the existing Android Web Client ID.
# Google Cloud must list https://samhaal.vercel.app as an authorized JavaScript origin.
VITE_GOOGLE_WEB_CLIENT_ID=
