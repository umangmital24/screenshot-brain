# Supabase backend/service credentials. Never expose SUPABASE_KEY to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-secret-key
SUPABASE_STORAGE_BUCKET=screenshots

# Gemini. Keep one production key server-side; never ship it in the APK.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Local semantic retrieval. This does not consume Gemini quota.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Quota controls.
# Intent extraction is a constrained JSON classification task, so thinking is disabled by default.
# Set -1 to restore dynamic thinking for A/B testing.
GEMINI_CAPTURE_THINKING_BUDGET=0
# Bound simultaneous Ask reasoning requests and per-user reasoning bursts.
GEMINI_CHAT_CONCURRENCY=3
GEMINI_CHAT_THINKING_BUDGET=512
ASK_REASONING_RPM=6
# Durable capture retry base after transient Gemini failures such as 429.
CAPTURE_RETRY_BASE_SECONDS=60
CAPTURE_MAX_ATTEMPTS=5

# Optional distributed rate limiting. If omitted, a single-instance in-memory fallback is used.
# Example: redis://default:password@host:6379/0
REDIS_URL=

# Web origin(s), comma-separated. Use your exact deployed frontend URL.
# Example: https://samhaal.app,https://www.samhaal.app
ALLOWED_ORIGINS=http://localhost:5173

# Protects GET /waitlist/admin. Keep server-side only.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Early-access launch: keep billing disabled.
ENABLE_BILLING=false
LOG_LEVEL=INFO
