# Supabase backend/service credentials. Never expose SUPABASE_KEY to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-secret-key
SUPABASE_STORAGE_BUCKET=screenshots

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Web origin(s), comma-separated. Use your exact deployed frontend URL.
# Example: https://samhaal.app,https://www.samhaal.app
ALLOWED_ORIGINS=http://localhost:5173

# Protects GET /waitlist/admin. Keep server-side only.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Early-access launch: keep billing disabled.
ENABLE_BILLING=false
LOG_LEVEL=INFO
